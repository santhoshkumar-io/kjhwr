# Copy to .env and fill in. Never commit .env.
#
# The Elexon BMRS API needs no key, so there is no secret here yet.
# This file exists so that any future credential has an obvious home
# and so .gitignore has something to protect.

# Comma-separated list of origins allowed to call the API (Phase 8).
# Local development default:
ALLOWED_ORIGINS=http://localhost:5173

# Base address for the Elexon BMRS API.
ELEXON_BASE_URL=https://data.elexon.co.uk/bmrs/api/v1
